# Ambiente do serviço "whatsapp" (projeto "mcp-servers") no EasyPanel.
# Só o acesso ao cofre: todas as senhas ficam no Azure Key Vault kv-bomgado-mcp.
# Carga/troca de senhas no cofre: python infra/segredos/carregar_cofre.py <arquivo .env>
#   Senhas esperadas: WHATSAPP_API_KEY, ESPELHO_DB_PASSWORD, WHISPER_CF_CLIENT_ID, WHISPER_CF_CLIENT_SECRET
KEYVAULT_URL=https://kv-bomgado-mcp.vault.azure.net/
AZURE_TENANT_ID=e97132bc-f926-4fba-9f6e-0379c8f25b23
# App registration do projeto mcp-servers (papel "Usuário de Segredos do Cofre de Chaves" no kv-bomgado-mcp)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Não são segredos:
MCP_TRUSTED_HOSTS=whatsapp-mcp.bomgado.net
WHISPER_URL=
TZ=America/Sao_Paulo
