# Copy to .env in this folder before deploying (or paste as env vars in EasyPanel's UI).

# REQUIRED: shared secret between whatsapp-bridge and whatsapp-mcp (internal channel only —
# this does NOT protect the public MCP endpoint, see README.md for that). Generate with:
#   openssl rand -hex 32
API_KEY=

# REQUIRED: the public hostname you'll point at whatsapp-mcp (no scheme, no port) — must
# match the Host header your Cloudflare Tunnel sends. Without this, every request gets
# "421 Invalid Host header" (see whatsapp-mcp-server/main.py for why).
MCP_TRUSTED_HOSTS=mcp-whatsapp-ext.bomgado.net

TZ=America/Sao_Paulo
